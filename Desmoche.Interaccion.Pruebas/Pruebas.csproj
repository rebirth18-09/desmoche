<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameSourceRoot Condition="'$(GameSourceRoot)' == ''">..\desmoche</GameSourceRoot>
    <InteractionSourceRoot Condition="'$(InteractionSourceRoot)' == ''">$(GameSourceRoot)\Scripts\Presentation\Interaction</InteractionSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ActionInteractionTests.cs" />
    <Compile Include="IncrementalDraftTests.cs" />
    <Compile Include="$(GameSourceRoot)\Scripts\Domain\**\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="$(GameSourceRoot)\Scripts\Application\**\*.cs" Link="Application\%(Filename)%(Extension)" />
    <Compile Include="$(GameSourceRoot)\Scripts\Networking\Core\**\*.cs" Link="Networking\%(Filename)%(Extension)" />
    <Compile Include="$(InteractionSourceRoot)\**\*.cs" Link="Interaction\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
