[node name="RulesText" type="Label" parent="HelpOverlay/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 18
text = "• Se juega con 52 cartas, sin comodines, entre 2 y 4 participantes.\n\n• Empiezas con 9 cartas. Elige una para entregar a tu derecha; recibirás otra de tu izquierda.\n\n• Forma tercias, cuartas o escaleras del mismo palo.\n\n• Una carta reclamada debe usarse en un juego válido; después paga una carta, salvo victoria.\n\n• Ganas automáticamente con exactamente 10 cartas combinadas y ninguna carta suelta.\n\n• En tercias y cuartas alterna rojo y negro. Si no lo haces, tus rivales tienen 2 segundos para decir Pasa.\n\n• Al inicio puedes declarar A-2-3-4 o J-Q-K-A ordenadas del mismo palo. Tras el cambio también puedes declarar Color, con la mano del mismo color ordenada, o Peladilla, si no puedes formar ningún juego."
autowrap_mode = 3


[node name="CloseButton" type="Button" parent="HelpOverlay/Center/Panel/Padding/Content"]
