[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/Presentation/MenuChoiceSelector.cs" id="selector"]

[ext_resource type="Texture2D" path="res://Assets/UI/Salon/Divider.svg" id="divider"]

[ext_resource type="Script" path="res://Scripts/Presentation/SingleplayerSetup.cs" id="script"]

[ext_resource type="Theme" path="res://Assets/UI/SalonTheme.tres" id="theme"]

[node name="Singleplayer" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="Center" type="CenterContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Panel" type="PanelContainer" parent="Scroll/Center"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2

[node name="Padding" type="MarginContainer" parent="Scroll/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_bottom = 32


[node name="Content" type="VBoxContainer" parent="Scroll/Center/Panel/Padding"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 48
theme_type_variation = &"GoldTitle"
text = "Jugar contra bots"
horizontal_alignment = 1
autowrap_mode = 3


[node name="SubtitleLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "Tu mesa, tu ritmo."
horizontal_alignment = 1
autowrap_mode = 3


[node name="LocalLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 16
text = "Sin conexión a Internet"
horizontal_alignment = 1
autowrap_mode = 3
theme_override_colors/font_color = Color(0.75, 0.8, 0.65, 1)

[node name="NameLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "Tu nombre"
autowrap_mode = 3


[node name="NameInput" type="LineEdit" parent="Scroll/Center/Panel/Padding/Content"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Jugador"
placeholder_text = "Escribe tu nombre"
max_length = 24
select_all_on_focus = true

[node name="BotCountLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "Número de bots"
autowrap_mode = 3


[node name="BotCountInput" type="HBoxContainer" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
script = ExtResource("selector")
BotCount = true

[node name="DifficultyLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "Dificultad"
autowrap_mode = 3


[node name="DifficultyInput" type="HBoxContainer" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
script = ExtResource("selector")

[node name="DifficultyHint" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 17
text = "Prioriza combinaciones y conserva cartas con posibilidades."
horizontal_alignment = 1
autowrap_mode = 3
custom_minimum_size = Vector2(0, 34)

[node name="Divider" type="TextureRect" parent="Scroll/Center/Panel/Padding/Content"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("divider")
expand_mode = 1
stretch_mode = 5

[node name="FairPlayLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 16
text = "Los bots no ven tu mano ni las cartas del mazo."
horizontal_alignment = 1
autowrap_mode = 3


[node name="MessageLabel" type="Label" parent="Scroll/Center/Panel/Padding/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 18
text = ""
horizontal_alignment = 1
autowrap_mode = 3
visible = false
theme_override_colors/font_color = Color(1, 0.7, 0.64, 1)

[node name="StartButton" type="Button" parent="Scroll/Center/Panel/Padding/Content"]
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Empezar partida"


[node name="BackButton" type="Button" parent="Scroll/Center/Panel/Padding/Content"]
